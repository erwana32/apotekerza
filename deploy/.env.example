# Copy to .env on the server. Never commit .env. Put real values only on the server.

# Application
APP_ENV=production
APP_PUBLIC_URL=https://pharmacy.example.com
LOG_LEVEL=info

# Caddy (production: set the real domain; local dev uses Caddyfile.local by default)
APP_DOMAIN=pharmacy.example.com
CADDYFILE=Caddyfile

# Database
POSTGRES_DB=apotekerza
POSTGRES_USER=apotekerza
POSTGRES_PASSWORD=SET_ON_SERVER
DATABASE_URL=postgres://apotekerza:SET_ON_SERVER@postgres:5432/apotekerza?sslmode=disable

# Sessions
SESSION_SECRET=SET_ON_SERVER

# Backups (storage outside the server)
BACKUP_TARGET=SET_ON_SERVER
BACKUP_ENCRYPTION_KEY=SET_ON_SERVER
