# Template of every variable the stack reads. Do not copy this file as is: start from
# the file for your environment instead.
#
#   Environment              Template to copy                Copy to           Used by
#   local dev (make dev-up)  none needed (defaults)          -                 make dev-up
#   staging on a laptop      deploy/.env.stg.example         deploy/.env.stg   make stg-up
#   production on a server   deploy/.env.prod.example        deploy/.env       make prod-up
#
# Never commit a real .env file. Real values live only on the machine that uses them.
# Compose reads these only to fill ${...} in the compose files; a variable reaches a
# container only if the compose file passes it in `environment:`.

# Which Caddyfile is mounted: Caddyfile.local (plain http://localhost) or Caddyfile (automatic TLS for APP_DOMAIN).
CADDYFILE=Caddyfile.local
# Real domain, production only (DNS must already point at the server).
APP_DOMAIN=

# local | staging | production
APP_ENV=local
LOG_LEVEL=info

# Database. The backend's DATABASE_URL is built from these three in the compose file, so there is
# no DATABASE_URL here. POSTGRES_DB is read only when the Postgres volume is first created:
# changing it later does not rename an existing database.
# Names: db_apotekerza_dev (local), db_apotekerza_stg, db_apotekerza_prod (docs/conventions/naming.md).
POSTGRES_DB=db_apotekerza_dev
POSTGRES_USER=apotekerza
# Use letters and digits only (e.g. `openssl rand -hex 32`): the password goes into a connection URL,
# where characters such as / + = : @ would break it. Different for every environment.
POSTGRES_PASSWORD=
