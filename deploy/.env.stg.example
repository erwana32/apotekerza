# Staging on a laptop. Copy to deploy/.env.stg (never committed), then: make stg-up
# Runs the base compose file only (no production override), over plain http://localhost.
# Chrome accepts the Secure session cookie on localhost; Safari does not.

APP_ENV=staging
LOG_LEVEL=debug

CADDYFILE=Caddyfile.local

POSTGRES_DB=db_apotekerza_stg
POSTGRES_USER=apotekerza
# Staging-only password; never reuse the production one. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=SET_LOCALLY
