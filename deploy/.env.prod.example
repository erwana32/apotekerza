# Production on the server. Copy to deploy/.env ON THE SERVER ONLY (never committed, never copied
# to a laptop), then: make prod-up
# Runs the base compose file plus docker-compose.prod.yml, which refuses to start when a value
# marked "required" is missing.

APP_ENV=production
LOG_LEVEL=info

# Automatic TLS for APP_DOMAIN. DNS must point at this server and ports 80 and 443 must be open.
CADDYFILE=Caddyfile
# required
APP_DOMAIN=pharmacy.example.com

# required
POSTGRES_DB=db_apotekerza_prod
# required
POSTGRES_USER=apotekerza
# required. Production-only; generate on the server: openssl rand -hex 32
POSTGRES_PASSWORD=SET_ON_SERVER

# Not used by the application yet; reserved for the backup job (docs/runbooks/, Phase 8).
# BACKUP_TARGET=
# BACKUP_ENCRYPTION_KEY=
